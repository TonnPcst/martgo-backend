APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s

POSTGRES_USER=martgo
POSTGRES_PASSWORD=martgo
POSTGRES_DB=martgo
POSTGRES_PORT=5433
DATABASE_URL=postgres://martgo:martgo@localhost:5433/martgo?sslmode=disable

# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_TTL=24h

# Used by the seed migration to create the default admin
ADMIN_EMAIL=admin@martgo.local
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Administrator

# Set to true only when running behind a proxy you control (nginx, load balancer)
TRUST_PROXY=false
ENABLE_DOCS=true
# Comma-separated browser origins allowed to call the API, e.g. http://localhost:5173
CORS_ALLOWED_ORIGINS=
