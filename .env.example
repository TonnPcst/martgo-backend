APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s

POSTGRES_USER=martgo
POSTGRES_PASSWORD=martgo
POSTGRES_DB=martgo
POSTGRES_PORT=5433
DATABASE_URL=postgres://martgo:martgo@localhost:5433/martgo?sslmode=disable

# Shared with the auth service (martgo-auth), which writes session state here
REDIS_URL=redis://localhost:6380/0

# Public half of the auth service's Ed25519 key: copy keys/jwt_public.pem from martgo-auth
JWT_PUBLIC_KEY_FILE=keys/jwt_public.pem

# Set to true when running behind the gateway (or another proxy you control)
TRUST_PROXY=false
ENABLE_DOCS=true
# Comma-separated browser origins allowed to call the API, e.g. http://localhost:5173
CORS_ALLOWED_ORIGINS=
